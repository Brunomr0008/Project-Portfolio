/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USB_DEVICE_Init();
  MX_ADC3_Init();
  MX_TIM1_Init();
  MX_TIM5_Init();
  MX_TIM6_Init();
  MX_TIM7_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Base_Start(&htim1);
  lcd_init();
  LCD_Methed(0); // LCD on Start
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  TaskButton();
	  TaskUSB();

	  if(flag_callback_timer7){
		  flag_callback_timer7 = 0,
		  Action2_TaskBuzzer();
	  }

	  if(flag_callback_timer6){
		  flag_callback_timer6 = 0;
		  Action2_TaskLed();
	  }

	  Action3();
  }
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  /** Supply configuration update enable
  */
  HAL_PWREx_ConfigSupply(PWR_LDO_SUPPLY);

  /** Configure the main internal regulator output voltage
  */
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE2);

  while(!__HAL_PWR_GET_FLAG(PWR_FLAG_VOSRDY)) {}

  /** Initializes the RCC Oscillators according to the specified parameters
  * in the RCC_OscInitTypeDef structure.
  */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_ON;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 1;
  RCC_OscInitStruct.PLL.PLLN = 42;
  RCC_OscInitStruct.PLL.PLLP = 2;
  RCC_OscInitStruct.PLL.PLLQ = 7;
  RCC_OscInitStruct.PLL.PLLR = 2;
  RCC_OscInitStruct.PLL.PLLRGE = RCC_PLL1VCIRANGE_3;
  RCC_OscInitStruct.PLL.PLLVCOSEL = RCC_PLL1VCOWIDE;
  RCC_OscInitStruct.PLL.PLLFRACN = 0;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /** Initializes the CPU, AHB and APB buses clocks
  */
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2
                              |RCC_CLOCKTYPE_D3PCLK1|RCC_CLOCKTYPE_D1PCLK1;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.SYSCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_HCLK_DIV1;
  RCC_ClkInitStruct.APB3CLKDivider = RCC_APB3_DIV2;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_APB1_DIV2;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_APB2_DIV2;
  RCC_ClkInitStruct.APB4CLKDivider = RCC_APB4_DIV2;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_3) != HAL_OK)
  {
    Error_Handler();
  }
}

/* USER CODE BEGIN 4 */
void TaskButton(void){
	static uint32_t button_press_time = 0;
	static uint8_t button_pressed = 0;
	static uint8_t Start_ToqueIntermitente = 0;
	static uint8_t n_button = 0;
	static uint8_t Flag_duration_1s_start = 0;
	static uint8_t toggle_action_2_button = 0;

	if(!flag_bloqueado){
		if (button == 1) { // Botão pressionado
			button = 0;
			n_button++;
			if (n_button == 1){
				button_pressed = 1;
				Flag_duration_1s_start = 1;
			}
		} else if (button == -1) { // Botão solto
			button = 0;
			button_pressed = 0;
		}
	}

	if (Flag_duration_1s_start == 0){
		button_press_time = HAL_GetTick(); // Salva o tempo do primeiro clique
	}

	// Clique longo (1s)
	if (HAL_GetTick() - button_press_time >= CLICK_TIMEOUT) {
		if(button_pressed == 0){
			if (Start_ToqueIntermitente == 0) {
				if (n_button == 1) { // Clique único
					Start_ToqueIntermitente = 1;
					HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);

					TaskBuzzer("ON B");
					TaskLed("ON L");

					Add_Comand("B"); // Inicia os handlers se necessário:
					Add_Comand("L");
				}
			}else{
				if (n_button == 2) { // Clique duplo
					HAL_GPIO_TogglePin(GPIOE, GPIO_PIN_1);

					if(!toggle_action_2_button){
						TaskBuzzer("ON B2");
						TaskLed("ON L2");

						Add_Comand("B2");
						Add_Comand("L2");
					}else{
						TaskBuzzer("OFF B2");
						TaskLed("OFF L2");

						Remove_Comand("B2");
						Remove_Comand("L2");
					}
				} else if (n_button == 3) { // Clique triplo
					HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, GPIO_PIN_SET);

					TaskBuzzer("ON B3");
					TaskLed("ON L3");
				}
			}


		}else{
			Start_ToqueIntermitente = 0;
			toggle_action_2_button = 0;

			TaskBuzzer("OFF B");
			TaskLed("OFF L");

			Remove_Comand("B");
			Remove_Comand("L");
			Remove_Comand("B2");
			Remove_Comand("L2");

			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
			HAL_GPIO_WritePin(GPIOE, GPIO_PIN_1, GPIO_PIN_RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, GPIO_PIN_RESET);
		}
		Flag_duration_1s_start = 0;
		n_button = 0; // Reseta contagem após processar o evento
	}
}

void TaskBuzzer(char *command) {
    if (compare_buf(command, "ON B")){ // Toque intermitente (0,5s)
        frequencia_Buzzer = 500;
        __HAL_TIM_SET_AUTORELOAD(&htim7, frequencia_Buzzer * 10);
		__HAL_TIM_SET_COUNTER(&htim7, 0);
        HAL_TIM_Base_Start_IT(&htim7);

    }else if (compare_buf(command, "ON B2")){ // Ajuste de frequência
    	action_2_buzzer = 1;

    }else if (compare_buf(command, "ON B3")){ // Toque rápido de 3s
    	if(action_2_buzzer == 1){
    		action_2_buzzer = 2; // modo de espera
    	}

    	time_action3_buzzer = HAL_GetTick();
        __HAL_TIM_SET_AUTORELOAD(&htim7, 150 * 10);
		__HAL_TIM_SET_COUNTER(&htim7, 0);
        HAL_TIM_Base_Start_IT(&htim7);

    }else if (compare_buf(command, "OFF B")){ // Desativa buzzer
    	action_2_buzzer = 0;

        HAL_GPIO_WritePin(GPIOG, GPIO_PIN_2, GPIO_PIN_RESET);
        HAL_TIM_Base_Stop_IT(&htim7);

    }else if (compare_buf(command, "OFF B2")){ //Desliga a açao 2 do buzzer
    	action_2_buzzer = 0;

    }else if (compare_buf(command, "ON BU")){ // Emergência: buzzer ativo
        HAL_GPIO_WritePin(GPIOG, GPIO_PIN_2, GPIO_PIN_SET);

    }else if (compare_buf(command, "OFF BU")){ // Emergência: buzzer desativado
        HAL_GPIO_WritePin(GPIOG, GPIO_PIN_2, GPIO_PIN_RESET);
    }
}


void Action2_TaskBuzzer(void){
	static int8_t invert = 1;
	static uint8_t toggle = 0;

	if(action_2_buzzer == 1){
		if(toggle ^= 1){
			if(frequencia_Buzzer <= 60){//alta frequencia
				invert = 1;
			}else if (frequencia_Buzzer >= 760){//baixa frequencia
				invert = -1;
			}

			frequencia_Buzzer = frequencia_Buzzer + 20 * invert;
			__HAL_TIM_SET_AUTORELOAD(&htim7, frequencia_Buzzer * 10);
			__HAL_TIM_SET_COUNTER(&htim7, 0); // Reinicia o contador
			HAL_TIM_Base_Start_IT(&htim7);
		}
	}
}

void TaskLed(char *command) {
	if (compare_buf(command, "ON L")){
		frequencia_Led = 500;
		__HAL_TIM_SET_AUTORELOAD(&htim6, frequencia_Led * 10);
		__HAL_TIM_SET_COUNTER(&htim6, 0);
		HAL_TIM_Base_Start_IT(&htim6);

		__HAL_TIM_SET_AUTORELOAD(&htim5, 1000 * 10);
		__HAL_TIM_SET_COUNTER(&htim5, 0);
		HAL_TIM_Base_Start_IT(&htim5);

	}else if (compare_buf(command, "ON L2")){
		action_2_led = 1;

	}else if (compare_buf(command, "ON L3")){
		if(action_2_led == 1){ // caso esteja ativo fica em modo de espera
			action_2_led = 2; // modo de espera
		}

		time_action3_led = HAL_GetTick();
		__HAL_TIM_SET_AUTORELOAD(&htim6, 150 * 10);
		__HAL_TIM_SET_COUNTER(&htim6, 0);
		HAL_TIM_Base_Start_IT(&htim6);

	}else if (compare_buf(command, "OFF L")){
		action_2_led = 0;
		HAL_TIM_Base_Stop_IT(&htim5);
		HAL_TIM_Base_Stop_IT(&htim6);
		HAL_GPIO_WritePin(GPIOC, Green_Pin, GPIO_PIN_RESET);
		HAL_GPIO_WritePin(GPIOC, Yellow_Pin, GPIO_PIN_RESET);

	}else if (compare_buf(command, "OFF L2")){
		action_2_led = 0;

	}else if (compare_buf(command, "ON LED")){ // Emergência: LED vermelho ativo
		HAL_GPIO_WritePin(GPIOC, Red_Pin, GPIO_PIN_SET);

	}else if (compare_buf(command, "OFF LED")){ // Emergência: LED vermelho desativado
		HAL_GPIO_WritePin(GPIOC, Red_Pin, GPIO_PIN_RESET);
	}
}

void Action2_TaskLed(void){
	static int8_t invert = 1;
	static uint8_t toggle = 0;

	if(action_2_led == 1){
		if(toggle ^= 1){
			if(frequencia_Led <= 60){//alta frequencia
				invert = 1;
			}else if (frequencia_Led >= 760){//baixa frequencia
				invert = -1;
			}

			frequencia_Led = frequencia_Led + 20 * invert;
			__HAL_TIM_SET_AUTORELOAD(&htim6, frequencia_Led * 10);
			__HAL_TIM_SET_COUNTER(&htim6, 0);
			HAL_TIM_Base_Start_IT(&htim6);
		}
	}
}

void Action3(void){
	if((HAL_GetTick() - time_action3_buzzer >= TIMEOUT_ACTION3) && time_action3_buzzer != 0){
		time_action3_buzzer = 0;

		if(action_2_buzzer == 2){
			action_2_buzzer = 1;
		}

		__HAL_TIM_SET_AUTORELOAD(&htim7, frequencia_Buzzer * 10);
		__HAL_TIM_SET_COUNTER(&htim7, 0);
		HAL_TIM_Base_Start_IT(&htim7);
		HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, GPIO_PIN_RESET);
	}

	if((HAL_GetTick() - time_action3_led >= TIMEOUT_ACTION3) && time_action3_led != 0){
		time_action3_led = 0;

		if(action_2_led == 2){
			action_2_led = 1;
		}

		__HAL_TIM_SET_AUTORELOAD(&htim6, frequencia_Led * 10);
		__HAL_TIM_SET_COUNTER(&htim6, 0);
		HAL_TIM_Base_Start_IT(&htim6);
		HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, GPIO_PIN_RESET);
	}
}

void TaskUSB(void){
	static uint8_t start_ldr = 0;
	static uint8_t alarme = 0;
	static char str[5];

	static uint8_t display_leitura = 0;
	static uint8_t pisca = 0;

	char *command[10] = {"ON B", "OFF B", "ON B2", "OFF B2", "ON B3", "ON L", "OFF L", "ON L2", "OFF L2", "ON L3"};
	char *add_command[10] = {"B", "B", "B2", "B2", "", "L", "L", "L2", "L2", ""};

	if(command_send[0] != 0){
		for(int h = 0; h < 10; h++){
			if(compare_buf(command_send, command[h])){ // terminar toque
				if((h >= 0) && (h <= 4)){
					TaskBuzzer(command[h]);
				}else{
					TaskLed(command[h]);
				}

				if((h == 0) || (h == 2) || (h == 5) || (h == 7)){
					Add_Comand(add_command[h]);
				}else if((h == 1) || (h == 3) || (h == 6) || (h == 8)){
					Remove_Comand(add_command[h]);
				}
				break;
			}
		}

		if(compare_buf(command_send, "ON LDR")){ // terminar toque
			if(start_ldr == 0){
				HAL_ADC_Start_IT(&hadc3);

				start_ldr = 1;
				LCD_Methed(1); // LCD on LDR
			}

		}else if(compare_buf(command_send, "OFF LDR")){ // terminar toque
			HAL_ADC_Stop_IT(&hadc3);

			ldr_value = 0;
			start_ldr = 0;
			LCD_Methed(0); // LCD on Start
		}

		for (int i = 0; i < 16; i++) {
			command_send[i] = 0;  // Limpa o array msg através do ponteiro
		}
	}

	if(start_ldr){
		if(display_leitura++ == 10){
			display_leitura = 0;

			if(pisca ^= 1){
				lcd_put_cur(1,15);
				lcd_send_string("!");
			}else{
				lcd_put_cur(1,15);
				lcd_send_string(".");
			}

			lcd_put_cur(0,12);
			Float_To_String(ldr_value, str);
			lcd_send_string(str);
		}

		if(ldr_value > 2.5 && !alarme){
			TaskBuzzer("OFF B");
			TaskLed("OFF L");

			TaskBuzzer("ON BU");
			TaskLed("ON LED");

			flag_bloqueado = 1;
			alarme = 1;

		}else if(ldr_value < 2.2 && alarme){
			TaskBuzzer("OFF BU");
			TaskLed("OFF LED");

			flag_bloqueado = 0;

			for (int i = 0; i < num_comandos_ativos; i++) {
				if(strcmp(comandos_ativos[i], "B") == 0){
					TaskBuzzer("ON B");
				}else if(strcmp(comandos_ativos[i], "B2") == 0){
					TaskBuzzer("ON B2");
				}else if(strcmp(comandos_ativos[i], "L") == 0){
					TaskLed("ON L");
				}else if(strcmp(comandos_ativos[i], "L2") == 0){
					TaskLed("ON L2");
				}
			}

			alarme = 0;
		}
	}
}



void Float_To_String(float valor, char *str) {
    // Parte inteira do valor
    int parteInteira = (int)valor;
    // Calcula a parte fracionária
    int parteFracionaria = (int)((valor - parteInteira) * 100);

    // Converte a parte inteira para string
    int indice = 0;
    str[indice++] = parteInteira + '0';

    // Adiciona o ponto decimal
    str[indice++] = '.';

    // Converte a parte fracionária para string
    str[indice++] = ((parteFracionaria / 10) % 10) + '0';
    str[indice++] = (parteFracionaria % 10) + '0';

    // Finaliza a string
    str[indice] = '\0';
}

void LCD_Methed(uint8_t Methed){
	lcd_clear();

	if(Methed){
		lcd_put_cur(0,0);
		lcd_send_string("LDR Value : ");
		lcd_put_cur(1,0);
		lcd_send_string("SE -> FreeRTOS");
	}else{
		lcd_put_cur(0,6);
		lcd_send_string("OFF!");
		lcd_put_cur(1,0);
		lcd_send_string("MEEC-> SETR-> G3");
	}
}

// Função para adicionar um comando à lista de comandos ativos
void Add_Comand(char *comando) {
    // Verificar se o comando já está ativo
    for (int i = 0; i < num_comandos_ativos; i++) {
        if (strcmp(comandos_ativos[i], comando) == 0) {
            // Se o comando já está ativo, não adiciona novamente
            return;
        }
    }

    // Se o comando não está ativo, adiciona-o à lista
    if (num_comandos_ativos < 10) {
        strcpy(comandos_ativos[num_comandos_ativos], comando);
        num_comandos_ativos++;
    }
}

// Função para remover um comando da lista de comandos ativos
void Remove_Comand(char *comando) {
    for (int i = 0; i < num_comandos_ativos; i++) {
        if (strcmp(comandos_ativos[i], comando) == 0) {
            // Mover os comandos para preencher o espaço do comando removido
            for (int j = i; j < num_comandos_ativos - 1; j++) {
                strcpy(comandos_ativos[j], comandos_ativos[j + 1]);
            }
            num_comandos_ativos--;
            break;
        }
    }
}
