<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/wallpaper"
    tools:context=".HomeMenu.Login">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="ScrollViewSize">

        <!-- Title -->
        <TextView
            android:id="@+id/textViewWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/welcome"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#AA6200EE"
            android:gravity="center"

            android:layout_marginTop="50dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Image -->
        <ImageView
            android:id="@+id/imageViewFox"
            android:layout_width="300dp"
            android:layout_height="300dp"

            android:src="@drawable/fox_final_app"
            android:contentDescription="@string/fox"

            app:layout_constraintTop_toBottomOf="@id/textViewWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Field E-mail -->
        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"

            android:background="@drawable/edittext_background"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:textColorHint="@color/dark_gray_fade"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:importantForAutofill="yes"
            android:autofillHints="emailAddress"

            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/imageViewFox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Field Password -->
        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"

            android:background="@drawable/edittext_background"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:textColorHint="@color/dark_gray_fade"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:importantForAutofill="yes"
            android:autofillHints="password"

            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/emailEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Toggle Password visibility button -->
        <ImageButton
            android:id="@+id/togglePasswordButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="togglePasswordButtonLogin"

            android:padding="8dp"
            android:contentDescription="@string/toggle_password_visibility"
            android:src="@drawable/visibility_off"
            android:background="@android:color/transparent"

            android:layout_marginEnd="60dp"
            app:layout_constraintBottom_toBottomOf="@id/passwordEditText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/passwordEditText" />

        <!-- Button Login -->
        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:onClick="loginOnClickBtn"

            android:text="@string/login"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/green_fox"

            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/passwordEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <LinearLayout
            android:id="@+id/socialButtonsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/buttonLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Button Email Registration -->
            <ImageButton
                android:id="@+id/buttonEmailAndPasswordRegister"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:onClick="buttonEmailAndPasswordRegister"
                android:padding="12dp"

                android:background="@drawable/circle_button_background"
                android:src="@drawable/baseline_email_36"
                android:contentDescription="@string/login"

                android:layout_marginEnd="24dp" />

            <!-- Button Phone Login -->
            <ImageButton
                android:id="@+id/buttonPhoneResister"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:onClick="buttonPhoneResister"
                android:padding="12dp"

                android:background="@drawable/circle_button_background"
                android:src="@drawable/baseline_phone_36"
                android:contentDescription="@string/login" />
        </LinearLayout>

        <!-- Button Reset Password -->
        <Button
            android:id="@+id/buttonForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="toForgotPasswordOnClickBtn"

            android:text="@string/ForgotPassword"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@android:color/transparent"

            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/socialButtonsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>