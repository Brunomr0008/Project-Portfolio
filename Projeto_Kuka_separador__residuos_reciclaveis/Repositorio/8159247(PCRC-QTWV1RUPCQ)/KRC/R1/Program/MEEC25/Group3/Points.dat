DECL POS PontoRecolhaArray[3]
DECL POS PontoDepositoArray[3]
DECL POS PontoIntermedioArray[6]

DECL INT count[3]; índices: 1=Amarelo, 2=Azul, 3=Verde

; ============================== ;
; Definição dos Inputs e Outputs ;
; ============================== ;
SIGNAL B_Branco $IN[20]
SIGNAL B_VERMELHO $IN[21]
SIGNAL B_PRETO $IN[22]

SIGNAL IN_POS1_AMARELO $IN[11]
SIGNAL IN_POS1_AZUL    $IN[12]
SIGNAL IN_POS1_VERDE   $IN[13]

SIGNAL IN_POS2_AMARELO $IN[14]
SIGNAL IN_POS2_AZUL    $IN[15]
SIGNAL IN_POS2_VERDE   $IN[16]

SIGNAL IN_POS3_AMARELO $IN[17]
SIGNAL IN_POS3_AZUL    $IN[18]
SIGNAL IN_POS3_VERDE   $IN[19]

SIGNAL LARANJA $OUT[23]
SIGNAL VERDE $OUT[22]
SIGNAL AZUL $OUT[21]
