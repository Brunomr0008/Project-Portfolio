&ACCESS RVP
DEF robotic ( )
   GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
   INTERRUPT ON 3 
   
   GLOBAL INTERRUPT DECL 4 WHEN B_VERMELHO==TRUE DO Parar_Robo()
   INTERRUPT ON 4
   
   GLOBAL INTERRUPT DECL 5 WHEN B_PRETO==TRUE DO Reset_Robo()
   INTERRUPT ON 5
   
   BAS (#INITMOV, 0)
   BAS (#TOOL, XTOOL)
   BAS (#BASE, XTOOLBASE)
   
   LOOP
      REINICIAR = FALSE
      
      ; Começar em Home
      SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
      
      Inicializacao()
   
      WHILE NOT REINICIAR
         WAIT SEC 0.1
         SinalAmarelo()
   
         IF B_Branco THEN
            leitura_visao()
         ENDIF
      ENDWHILE
   ENDLOOP  
END

DEF Inicializacao ()
   ; Atribuir os pontos ao array
   PontoRecolhaArray[1] = P1_Recolha
   PontoRecolhaArray[2] = P2_Recolha
   PontoRecolhaArray[3] = P3_Recolha
   
   ; Atribuir os pontos ao array
   PontoDepositoArray[1] = P1_Deposito
   PontoDepositoArray[2] = P2_Deposito
   PontoDepositoArray[3] = P3_Deposito
   
   ; Atribuir os pontos ao array
   PontoIntermedioArray[1] = P1_Intermedia
   PontoIntermedioArray[2] = P2_Intermedia
   PontoIntermedioArray[3] = P3_Intermedia
   PontoIntermedioArray[4] = P4_Intermedia
   PontoIntermedioArray[5] = P5_Intermedia
   PontoIntermedioArray[6] = P6_Intermedia
   
   count[1] = 0
   count[2] = 0
   count[3] = 0
END

DEF SinalVerde()
  AZUL = FALSE  ; Luz amarela OFF
  VERDE = TRUE   ; Luz verde ON
  LARANJA = FALSE  ; Luz vermelha OFF
END

DEF SinalAmarelo()
  AZUL = TRUE   ; Luz amarela ON
  VERDE = FALSE  ; Luz verde OFF
  LARANJA = FALSE  ; Luz vermelha OFF
END

DEF SinalErro()
  AZUL = FALSE  ; Luz amarela OFF
  VERDE = FALSE  ; Luz verde OFF
  LARANJA = TRUE   ; Luz vermelha ON
END 

DEF leitura_visao ()
   DECL INT i, j

   ; Mapear sinais de visão para índices
   DECL BOOL visao[9]
   
   visao[1] = IN_POS1_VERDE
   visao[2] = IN_POS1_AMARELO
   visao[3] = IN_POS1_AZUL
   visao[4] = IN_POS2_VERDE
   visao[5] = IN_POS2_AMARELO
   visao[6] = IN_POS2_AZUL
   visao[7] = IN_POS3_VERDE
   visao[8] = IN_POS3_AMARELO
   visao[9] = IN_POS3_AZUL
   
   SinalVerde ()
   
   FOR i = 1 TO 3
      IF count[i] < 3 THEN
         FOR j = 1 TO 3
            IF visao[1 + (i-1) + ((j-1)*3)] THEN
               Recolher(PontoRecolhaArray[j], PontoIntermedioArray[j])
               Deposito(PontoDepositoArray[i], PontoIntermedioArray[i + 3], count[i])
               count[i] = count[i] + 1
            ENDIF
         ENDFOR
      ELSE
         SinalErro() 
         WAIT SEC 1
      ENDIF
            
      WAIT SEC 0.1       
      IF REINICIAR THEN
         RETURN
      ENDIF
      
   ENDFOR
END

DEF Recolher(PontoBase:IN, PontoIntermedio:IN)
   DECL POS PontoBase, PontoIntermedio, PontoBaixo, PontoRotacionado
   DECL INT Z_Variation, ROTATION

   ; Começar em Home
   SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Parâmetros ajustáveis (podes também passar por argumento ou definir globais) ---
   Z_Variation = 124      ; altura para baixar (negativo = descer)
   ROTATION    = 60       ; graus a rodar no eixo C

   ; --- Ir ao ponto base (posição inicial acima do objeto) ---

   ;FOLD SPTP PontoBase Vel=80 % PDAT2 Tool[2]:Tool_G3 Base[1]:Base_G3 ;%{PE}
   ;FOLD Parameters ;%{h}
   ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=PontoBase; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT2; Kuka.VelocityPtp=80; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
   ;ENDFOLD
   SPTP PontoBase WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $TOOL = STOOL2(FPontoBase), $BASE = SBASE(FPontoBase.BASE_NO), $IPO_MODE = SIPO_MODE(FPontoBase.IPO_FRAME), $LOAD = SLOAD(FPontoBase.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDAT1), $APO = SAPO_PTP(PDAT1), $GEAR_JERK[1] = SGEAR_JERK(PDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
   ;ENDFOLD
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Baixar até à altura do objeto ---
   PontoBaixo = PontoBase
   PontoBaixo.Z = PontoBase.Z + Z_Variation
   SPTP PontoBaixo WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT2.VEL), $ACC_AXIS[1] = SACC_JOINT(PDAT2), $APO.CDIS = PDAT2.APO_DIST
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Rodar no local (C = eixo de rotação em torno do TCP) ---
   PontoRotacionado = PontoBaixo
   PontoRotacionado.C = PontoBaixo.C + ROTATION
   SPTP PontoRotacionado WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $ACC_AXIS[1] = SACC_JOINT(PDAT1), $APO.CDIS = PDAT1.APO_DIST
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Subida Intermédia ---
   SPTP PontoIntermedio WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT2.VEL), $ACC_AXIS[1] = SACC_JOINT(PDAT2), $APO.CDIS = PDAT2.APO_DIST
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; Começar em Home
   SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
   
END

DEF Deposito(PontoDeposito:IN, PontoIntermedio:IN, count:IN)
   DECL POS PontoDeposito, PontoIntermedio, PontoBaixo, PontoRotacionado
   DECL INT Z_Variation, ROTATION, count

   ; --- Parâmetros ajustáveis (podes também passar por argumento ou definir globais) ---
   Z_Variation = 121      ; altura para baixar (negativo = descer)
   ROTATION    = 60       ; graus a rodar no eixo C
   
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ;FOLD SPTP PontoDeposito Vel=80 % PDAT3 Tool[2]:Tool_G3 Base[1]:Base_G3 ;%{PE}
   ;FOLD Parameters ;%{h}
   ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=PontoDeposito; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT3; Kuka.VelocityPtp=80; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
   ;ENDFOLD
   SPTP PontoDeposito WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $TOOL = STOOL2(FPontoDeposito), $BASE = SBASE(FPontoDeposito.BASE_NO), $IPO_MODE = SIPO_MODE(FPontoDeposito.IPO_FRAME), $LOAD = SLOAD(FPontoDeposito.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDAT1), $APO = SAPO_PTP(PDAT1), $GEAR_JERK[1] = SGEAR_JERK(PDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
   ;ENDFOLD
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Baixar até à altura do objeto ---
   PontoBaixo = PontoDeposito
   PontoBaixo.Z = PontoDeposito.Z + Z_Variation - (count * 25)
   SPTP PontoBaixo WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT2.VEL), $ACC_AXIS[1] = SACC_JOINT(PDAT2), $APO.CDIS = PDAT2.APO_DIST
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Rodar no local (C = eixo de rotação em torno do TCP) ---
   PontoRotacionado = PontoBaixo
   PontoRotacionado.C = PontoBaixo.C + ROTATION
   SPTP PontoRotacionado WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $ACC_AXIS[1] = SACC_JOINT(PDAT1), $APO.CDIS = PDAT1.APO_DIST
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; --- Subida Intermédia ---
   SPTP PontoIntermedio WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT2.VEL), $ACC_AXIS[1] = SACC_JOINT(PDAT2), $APO.CDIS = PDAT2.APO_DIST
   WAIT SEC 0.1
   IF REINICIAR THEN
      RETURN
   ENDIF
   
   ; Começar em Home
   SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(PDAT1.VEL), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
 
END

DEF Parar_Robo()
   SinalAmarelo()
   WHILE (NOT B_Branco) OR B_VERMELHO
      WAIT SEC 0.1
   ENDWHILE
END

DEF Reset_Robo()
   REINICIAR = TRUE
END