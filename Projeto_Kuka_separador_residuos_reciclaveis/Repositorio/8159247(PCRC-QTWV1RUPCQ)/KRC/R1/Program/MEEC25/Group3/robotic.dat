SIGNAL IN_POS1_AZUL   $IN[13]

SIGNAL IN_POS2_VERDE $IN[14]
SIGNAL IN_POS2_AMARELO    $IN[15]
SIGNAL IN_POS2_AZUL   $IN[16]

SIGNAL IN_POS3_VERDE $IN[17]
SIGNAL IN_POS3_AMARELO    $IN[18]
SIGNAL IN_POS3_AZUL   $IN[19]

SIGNAL LARANJA $OUT[23]
SIGNAL VERDE $OUT[22]
SIGNAL AZUL $OUT[21]
